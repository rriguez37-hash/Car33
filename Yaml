name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: 17

      - name: Descomprimir proyecto
        run: unzip -q -o ./*.zip

      - name: Compilar APK
        working-directory: CarMusic-Diagnostic
        run: |
          chmod +x ./gradlew
          ./gradlew assembleDebug --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: CarMusic-Diagnostic
          path: CarMusic-Diagnostic/app/build/outputs/apk/debug/CarMusic-Diagnostic.apk
